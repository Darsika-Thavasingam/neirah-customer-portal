generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANT & USER
// ============================================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
  projects  Project[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  email     String   @unique
  name      String
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  portalAccess CustomerPortalAccess?

  @@index([tenantId])
  @@map("users")
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyName String?
  contactName String
  email       String
  phone       String?
  address     String?
  billingInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  portalAccess CustomerPortalAccess?
  projects     Project[]
  quotations   Quotation[]
  contracts    Contract[]
  invoices     Invoice[]
  payments     Payment[]

  @@index([tenantId])
  @@map("customers")
}

// ============================================================
// CUSTOMER PORTAL ACCESS
// ============================================================

model CustomerPortalAccess {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  customerId String    @unique @db.Uuid
  userId     String    @unique @db.Uuid
  isActive   Boolean   @default(true)
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("customer_portal_access")
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  customerId             String    @db.Uuid
  projectCode            String
  name                   String
  location               String?
  startDate              DateTime?
  expectedCompletionDate DateTime?
  status                 String
  progress               Int       @default(0)
  currentPhase           String?
  projectManagerName     String?
  projectManagerContact  String?
  recentUpdate           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  customer   Customer                  @relation(fields: [customerId], references: [id])
  milestones Milestone[]
  updates    ProjectUpdate[]
  photos     ProjectPhoto[]
  documents  CustomerVisibleDocument[]
  quotations Quotation[]
  contracts  Contract[]
  invoices   Invoice[]

  @@unique([tenantId, projectCode])
  @@index([tenantId])
  @@index([customerId])
  @@map("projects")
}

// ============================================================
// CUSTOMER PROJECT ACCESS
// ============================================================

model CustomerProjectAccess {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  projectId  String   @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([customerId, projectId])
  @@index([tenantId])
  @@map("customer_project_access")
}

// ============================================================
// MILESTONES
// ============================================================

model Milestone {
  id                   String    @id @default(uuid()) @db.Uuid
  projectId            String    @db.Uuid
  name                 String
  description          String?
  plannedDate          DateTime?
  actualCompletionDate DateTime?
  status               String
  progress             Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("milestones")
}

// ============================================================
// PROJECT UPDATES
// ============================================================

model ProjectUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  projectId  String   @db.Uuid
  title      String
  update     String
  postedBy   String?
  attachment String?
  visibility Boolean  @default(true)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@map("project_updates")
}

// ============================================================
// PROJECT PHOTOS
// ============================================================

model ProjectPhoto {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  projectId         String   @db.Uuid
  photoUrl          String
  caption           String?
  category          String?
  isCustomerVisible Boolean  @default(true)
  uploadedAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@map("project_photos")
}

// ============================================================
// CUSTOMER VISIBLE DOCUMENTS
// ============================================================

model CustomerVisibleDocument {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  projectId         String?  @db.Uuid
  category          String
  fileName          String
  fileUrl           String
  isCustomerVisible Boolean  @default(true)
  uploadedAt        DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@map("customer_visible_documents")
}

// ============================================================
// QUOTATIONS
// ============================================================

model Quotation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  customerId      String    @db.Uuid
  projectId       String?   @db.Uuid
  quotationNumber String
  date            DateTime
  validUntil      DateTime?
  subtotal        Decimal   @db.Decimal(12, 2)
  tax             Decimal   @db.Decimal(12, 2)
  discount        Decimal   @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  status          String
  documentUrl     String?
  terms           String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id])
  project  Project?        @relation(fields: [projectId], references: [id])
  items    QuotationItem[]

  @@unique([tenantId, quotationNumber])
  @@index([customerId])
  @@index([projectId])
  @@index([tenantId])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(uuid()) @db.Uuid
  quotationId String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal @db.Decimal(12, 2)
  tax         Decimal @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ============================================================
// CONTRACTS
// ============================================================

model Contract {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  customerId     String    @db.Uuid
  projectId      String?   @db.Uuid
  contractNumber String
  contractDate   DateTime
  contractValue  Decimal   @db.Decimal(12, 2)
  startDate      DateTime?
  completionDate DateTime?
  status         String
  documentUrl    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])

  @@unique([tenantId, contractNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@map("contracts")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  customerId        String   @db.Uuid
  projectId         String?  @db.Uuid
  invoiceNumber     String
  invoiceDate       DateTime
  dueDate           DateTime
  contractReference String?
  subtotal          Decimal  @db.Decimal(12, 2)
  tax               Decimal  @db.Decimal(12, 2)
  discount          Decimal  @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(12, 2)
  paidAmount        Decimal  @default(0) @db.Decimal(12, 2)
  status            String
  documentUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  project  Project?      @relation(fields: [projectId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  tax         Decimal @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  customerId       String   @db.Uuid
  invoiceId        String?  @db.Uuid
  paymentReference String
  paymentDate      DateTime
  paymentMethod    String
  amount           Decimal  @db.Decimal(12, 2)
  status           String
  receiptReference String?
  createdAt        DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@map("payments")
}

// ============================================================
// CUSTOMER NOTIFICATIONS
// ============================================================

model CustomerNotification {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_notifications")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entity     String
  entityId   String?  @db.Uuid
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  requestId  String?
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

